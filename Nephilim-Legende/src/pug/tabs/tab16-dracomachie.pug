.tab16
    .col40.triskel-wrapper
        .triskel
            div.top
                label
                    span Passes
                    +numberInput('passes', 0)
            div.bottom
                label
                    span Rites
                    +numberInput('rites', 0)
                label
                    span Charmes
                    +numberInput('charmes', 0)

    .col60.actionsDraco
        label
            +rollButton('controle', roll_draco_controle, 'Perte de contrôle')
            +numberInput('perteControle', 0)(readonly)
            +hiddenInput('perteControle', 0)
        h2 Arène
        label
            span Menace de l’ED
            +numberInput('dracomenace', 0)
            span Élément de l’ED
            +elemSelect('dracoelem')
        label
            +rollButton('terrain', roll_draco_terrain, 'Délimiter l’arène')
        label
            span Coups portés par l’ED
            +numberInput('dracohits', 0)


    .col2
        .draco-techs
            h1 Techniques dracomaques
            span Techniques
            span Diff.
            span Art
            span &nbsp;
            fieldset.repeating_dracotech
                +cbButton('attr_expand', null, 1)
                +textInput('nom')
                +hiddenInput('art', 0)
                +numberInput('diff', 0)
                select(name='attr_art')
                    option(value=0)
                    option(value='passe') Passe
                    option(value='rite') Rite
                    option(value='charme') Charme
                +rollButton('draco_passe', roll_draco_passe)(title='Exécuter une technique')
                +rollButton('draco_rite', roll_draco_rite)(title='Exécuter une technique')
                +rollButton('draco_charme', roll_draco_charme)(title='Exécuter une technique')
                +hiddenInput('expand', 1)
                div
                    .autoex.autoex22
                        +spanareaInput('detail')(placeholder='Détails')

    .col2
        .draco-items
            h1 Effets &amp; artefacts dragons
            span Nom
            span(title='Élément') Élem.
            span(title='Degré ou Menace') Deg.
            fieldset.repeating_dracoart
                +cbButton('attr_expand', null, 1)
                +textInput('nom')
                +elemSelect('elem')
                +numberInput('degre', 0)
                +hiddenInput('expand', 1)
                .autoex.autoex22
                    +spanareaInput('description')(placeholder='Description')
