.tab15
    h1.titreSecret Grand Secret
        +numberInput('mag-secret-degre', 0)

    .gsDomains.col40
        .vIEL
            h1 Voie Initiatique
            select(name='attr_mag-voie')
                option(value='0' selected)
                option(value='sentier-sinueux') Sentier sinueux
                option(value='spirale-elevation') Spirale d'élévation
                option(value='principe-egarants') Principes égarants
                option(value='labyrinthe-ame') Labyrinthe schématique
                option(value='dedale-ame') Dédale de l'âme
        .vIEL
            h1 Domaines
            each i in [1, 2]
                select(name=`attr_mag-gs-dom${i}`)
                    option(value='0' selected)
                    option(value='comprendre') Comprendre
                    option(value='controler') Contrôler
                    option(value='creer') Créer
                    option(value='detruire') Détruire
                    option(value='transformer') Transformer
            +degreMetamorphe()
    .col60
        .gsMaillons
            h1
                div Maillons
                div
                    +numberInput('magSecretCurrentLinks')(readonly)
                    | &nbsp;/&nbsp;
                    +numberInput('magSecretAllowedLinks')
            .repeating-maillon-wrapper
                fieldset.repeating_maillon
                    +elemSelect('maillon-ka')
                    +textInput('maillon')
    .habitus
        h1 Habitus
        span Nom de l’Habitus
        span Voie
        span Ka
        span Portée
        span Durée
        span Degré
        span(title='Appris') A
        span(title='Tatoué') T
        span(title='Sur Focus') F
        span
        fieldset.repeating_habitus
            +cbButton('attr_expand', null, 1)(checked)
            +textInput('nom')
            select(name=`attr_voie`)
                option(value='0' selected)
                option(value='sentier-sinueux') Sentier sinueux
                option(value='spirale-elevation') Spirale d'élévation
                option(value='principe-egarants') Principes égarants
                option(value='labyrinthe-ame') Labyrinthe schématique
                option(value='dedale-ame') Dédale de l'âme
            +elemSelect('ka')
            select(name='attr_portee')
                option(value='', selected)
                option(value='0') Personnelle (partie)
                option(value='1') Personnelle (entier)
                option(value='2') Contact
                option(value='3') Ka-elem mètres
                option(value='4') Ka-elem kilomètres
                option(value='4.0') Portée de vue
                option(value='5') Région
                option(value='6') Continent
                option(value='7') Illimitée (monde physique)
                option(value='8') Illimitée (monde magique)
                option(value='9') Extra-terrestre
                option(value='10') Temporelle
            select(name='attr_duree')
                option(value='', selected)
                option(value='0') Ka-elem rounds
                option(value='1') Ka-elem minutes
                option(value='2') Ka-elem heures
                option(value='3') Ka-elem jours
                option(value='4') Ka-elem semaines
                option(value='5') Ka-elem mois
                option(value='6') Ka-elem années
                option(value='7') Ka-elem décennies
                option(value='8') Ka-elem siècles
                option(value='9') Ka-elem millénaires
                option(value='10') Ka-elem ères
            +numberInput('degre')(readonly)
            +cbButton('attr_appris', 'Appris')(value=1)
            +cbButton('attr_tatoue', 'Tatoué')(value=1)
            +cbButton('attr_focus', 'Sur Focus')(value=1)
            +rollButton('sheet-simu-roll-vecu', roll_habitus)
            +hiddenInput('expand', 1)
            div
                label
                    span Syntaxe
                    +textInput('syntaxe')
                label
                    span Maillons
                    +numberInput('maillons', 0)(readonly)
                label
                    span Difficulté
                    +numberInput('difficulte', 0)(readonly)
                .autoex.autoex22
                    +spanareaInput('habitus-desc')(placeholder='Description')

