//- views/_character.pug
//- Character tab: identity header, truths & scars, vitals, attributes,
//- skills, languages, xp, weapons and armor.
//-
//- Each panel lives in views/panels/ with its markup, CSS and the workers
//- only it uses. Workers shared across files are in
//- views/_global_sheetworker.pug, included first.
//-
//- buildVersion is stamped at build time into both the footer HTML and the
//- footer CSS. If they differ in Roll20, one of the two pastes (Sheet Layout
//- or Sheet Style) is stale.
- const buildVersion = new Date().toISOString().replace('T', ' ').slice(0, 19) + ' UTC'
//- Every calculation that reads character_type reruns when it changes.
- const ccCharacterTypeTrigger = {affects: ['npc_sheet', 'stress_max_base', 'stress_max', 'stress_max_marker', 'fatigue_max_marker', 'courage', 'total_armor', 'injury_limit', 'power_rating', 'spells_type_marker']}
//- Identity choices. Each archetype has two specializations.
- const ccCultures = ['Roman citizen', 'Germanic tribe', 'Ægyptus', 'Briton', 'Gaul', 'Greek', 'Foederati', 'Other']
- const ccCastes = ['Outcast', 'Servant', 'Plebeian', 'Freedman', 'Noble']
- const ccSpecializations = {Mystic: ['Lupercus', 'Staff Bearer'], Sage: ['Engineer', 'Medicus'], Schemer: ['Frumentarius', 'Magistrate'], Scoundrel: ['Robber', 'Sicarius'], Scout: ['Hunter', 'Veles'], Soldier: ['Berserker', 'Legionary']}

include ./_global_sheetworker.pug

+tab({name: 'character', container: 'article', button: {content: 'Character'}})
  .cc-page.cc-character

    .cc-banner Cohors Cthulhu
    //- Shows the sheet as a player character or one of the three NPC tiers
    //- (Roll20 allows one sheet per game). No value behaves as "pc". Trooper
    //- and Toughened get a compact combat layout; Nemesis keeps the full
    //- sheet plus the NPC panels. Old cannon_fodder/npc values are migrated
    //- by ccRecomputeOnOpen.
    //-
    //- The Player/NPC switch beside the tabs (Cohors_Cthulhu.pug) picks
    //- between "pc" and a tier; the tier labels below show on NPC sheets.
    //- The radios are direct children of .cc-page.cc-character so the ~
    //- selectors reach the panels; only the labels sit in .cc-character-type.
    //- The Spells tab uses its own marker (spells_type_marker).
    +radio({name: 'character_type', value: 'pc', checked: '', trigger: ccCharacterTypeTrigger}).cc-character-type-input#cc-character-type-pc
    +radio({name: 'character_type', value: 'trooper', trigger: ccCharacterTypeTrigger}).cc-character-type-input#cc-character-type-trooper
    +radio({name: 'character_type', value: 'toughened', trigger: ccCharacterTypeTrigger}).cc-character-type-input#cc-character-type-toughened
    +radio({name: 'character_type', value: 'nemesis', trigger: ccCharacterTypeTrigger}).cc-character-type-input#cc-character-type-nemesis
    //- The tier to restore when the switch goes back to NPC (ccSetSheetMode).
    +hidden({name: 'npc last tier'})
    .cc-character-type
      label.cc-character-type-label(for='cc-character-type-trooper') Trooper
      label.cc-character-type-label(for='cc-character-type-toughened') Toughened
      label.cc-character-type-label(for='cc-character-type-nemesis') Nemesis
    .cc-field-group.cc-identity-core
      .cc-field
        span Name & Pronoun
        +text({name: 'name pronoun'})
    //- Cut for Trooper/Toughened NPCs.
    .cc-field-group.cc-identity-extra
      .cc-field
        span Culture
        +select({name: 'culture', trigger: {triggeredFuncs: ['ccUpdateTalentFilter']}})
          +option({value: ''})
            | Select One
          +option({value: 'Roman citizen'})
            | Roman citizen
          +option({value: 'Germanic tribe'})
            | Germanic tribe
          +option({value: 'Ægyptus'})
            | Ægyptus
          +option({value: 'Briton'})
            | Briton
          +option({value: 'Gaul'})
            | Gaul
          +option({value: 'Greek'})
            | Greek
          +option({value: 'Foederati'})
            | Foederati
          +option({value: 'Other'})
            | Other
      .cc-field
        span Caste
        +select({name: 'caste', trigger: {triggeredFuncs: ['ccUpdateTalentFilter']}})
          +option({value: ''})
            | Select One
          +option({value: 'Outcast'})
            | Outcast
          +option({value: 'Servant'})
            | Servant
          +option({value: 'Plebeian'})
            | Plebeian
          +option({value: 'Freedman'})
            | Freedman
          +option({value: 'Noble'})
            | Noble
      .cc-field
        span Wealth
        +text({name: 'wealth'})
    //- Also cut for Trooper/Toughened.
    .cc-field-group.cc-identity-flavor
      //- Hidden radios mirroring Archetype (calcArchetypeMarker), so CSS can
      //- show the matching Specialization select.
      +radio({name: 'archetype marker', value: 'none', checked: '', trigger: {calculation: 'calcArchetypeMarker'}}).cc-archetype-marker.cc-archetype-marker-none
      +radio({name: 'archetype marker', value: 'mystic', trigger: {calculation: 'calcArchetypeMarker'}}).cc-archetype-marker.cc-archetype-marker-mystic
      +radio({name: 'archetype marker', value: 'sage', trigger: {calculation: 'calcArchetypeMarker'}}).cc-archetype-marker.cc-archetype-marker-sage
      +radio({name: 'archetype marker', value: 'schemer', trigger: {calculation: 'calcArchetypeMarker'}}).cc-archetype-marker.cc-archetype-marker-schemer
      +radio({name: 'archetype marker', value: 'scoundrel', trigger: {calculation: 'calcArchetypeMarker'}}).cc-archetype-marker.cc-archetype-marker-scoundrel
      +radio({name: 'archetype marker', value: 'scout', trigger: {calculation: 'calcArchetypeMarker'}}).cc-archetype-marker.cc-archetype-marker-scout
      +radio({name: 'archetype marker', value: 'soldier', trigger: {calculation: 'calcArchetypeMarker'}}).cc-archetype-marker.cc-archetype-marker-soldier
      .cc-field
        span Archetype
        +select({name: 'archetype', trigger: {affects: ['archetype_marker'], triggeredFuncs: ['ccCheckSpecialization', 'ccUpdateTalentFilter']}})
          +option({value: ''})
            | Select One
          +option({value: 'Mystic'})
            | Mystic
          +option({value: 'Sage'})
            | Sage
          +option({value: 'Schemer'})
            | Schemer
          +option({value: 'Scoundrel'})
            | Scoundrel
          +option({value: 'Scout'})
            | Scout
          +option({value: 'Soldier'})
            | Soldier
      .cc-field
        span Specialization
        //- One select per archetype on the same attribute; CSS shows the one
        //- for the checked archetype marker.
        +select({name: 'specialization', trigger: {triggeredFuncs: ['ccUpdateTalentFilter']}}).cc-specialization.cc-specialization-none
          +option({value: ''})
            | Pick an archetype first
        +select({name: 'specialization', trigger: {triggeredFuncs: ['ccUpdateTalentFilter']}}).cc-specialization.cc-specialization-mystic
          +option({value: ''})
            | Select One
          +option({value: 'Lupercus'})
            | Lupercus
          +option({value: 'Staff Bearer'})
            | Staff Bearer
        +select({name: 'specialization', trigger: {triggeredFuncs: ['ccUpdateTalentFilter']}}).cc-specialization.cc-specialization-sage
          +option({value: ''})
            | Select One
          +option({value: 'Engineer'})
            | Engineer
          +option({value: 'Medicus'})
            | Medicus
        +select({name: 'specialization', trigger: {triggeredFuncs: ['ccUpdateTalentFilter']}}).cc-specialization.cc-specialization-schemer
          +option({value: ''})
            | Select One
          +option({value: 'Frumentarius'})
            | Frumentarius
          +option({value: 'Magistrate'})
            | Magistrate
        +select({name: 'specialization', trigger: {triggeredFuncs: ['ccUpdateTalentFilter']}}).cc-specialization.cc-specialization-scoundrel
          +option({value: ''})
            | Select One
          +option({value: 'Robber'})
            | Robber
          +option({value: 'Sicarius'})
            | Sicarius
        +select({name: 'specialization', trigger: {triggeredFuncs: ['ccUpdateTalentFilter']}}).cc-specialization.cc-specialization-scout
          +option({value: ''})
            | Select One
          +option({value: 'Hunter'})
            | Hunter
          +option({value: 'Veles'})
            | Veles
        +select({name: 'specialization', trigger: {triggeredFuncs: ['ccUpdateTalentFilter']}}).cc-specialization.cc-specialization-soldier
          +option({value: ''})
            | Select One
          +option({value: 'Berserker'})
            | Berserker
          +option({value: 'Legionary'})
            | Legionary
      .cc-field
        span Background
        +text({name: 'background'})
      .cc-field
        span Characteristic
        +text({name: 'characteristic'})

    include ./panels/_npc_profile_panel.pug
    include ./panels/_truths_scars_panel.pug
    include ./panels/_vitals_panel.pug
    include ./panels/_attributes_panel.pug
    include ./panels/_skills_panel.pug
    include ./panels/_weapons_panel.pug
    include ./panels/_armor_panel.pug
    include ./panels/_talents_panel.pug
    include ./panels/_special_rules_panel.pug

    .cc-field-group
      .cc-field.cc-languages
        span Languages
        +textarea({name: 'languages'})
      include ./panels/_experience_panel.pug

    .cc-footer
      span.cc-build-html HTML build: #{buildVersion}

+module.
  const ccCultures = !{JSON.stringify(ccCultures)};
  const ccCastes = !{JSON.stringify(ccCastes)};
  const ccSpecializations = !{JSON.stringify(ccSpecializations)};

  // The Player/NPC switch (npc_sheet). Switching to NPC restores the last
  // tier (Toughened the first time); switching to Player remembers it.
  // Setting character_type reruns everything that reads it.
  const ccSetSheetMode = ({attributes}) => {
    const npc = Number(attributes.npc_sheet) === 1;
    if (npc && !ccIsNpc(attributes)) {
      attributes.character_type = ccNpcTiers.includes(attributes.npc_last_tier) ? attributes.npc_last_tier : 'toughened';
    } else if (!npc && ccIsNpc(attributes)) {
      attributes.npc_last_tier = attributes.character_type;
      attributes.character_type = 'pc';
    }
  };
  // The switch follows character_type when that changes some other way.
  const calcNpcSheet = ({attributes}) => (ccIsNpc(attributes) ? 1 : 0);
  k.registerFuncs({ccSetSheetMode, calcNpcSheet});

  // Sync the archetype marker radios with Archetype.
  const calcArchetypeMarker = ({attributes}) => {
    const archetype = String(attributes.archetype || '').toLowerCase();
    return ccSpecializations[attributes.archetype] ? archetype : 'none';
  };
  k.registerFuncs({calcArchetypeMarker});

  // A new archetype clears a specialization that belongs to another one.
  const ccCheckSpecialization = ({attributes}) => {
    const allowed = ccSpecializations[attributes.archetype] || [];
    if (attributes.specialization && !allowed.includes(attributes.specialization)) {
      attributes.specialization = '';
    }
  };
  k.registerFuncs({ccCheckSpecialization});

  // The dropdown option matching a free-text value: same text ignoring case
  // and accents, or an option that starts with it ("Roman" -> "Roman
  // citizen"). Unmatched values are kept as they are.
  const ccMatchOption = (value, options) => {
    const plain = (text) => String(text || '').normalize('NFD').replace(/[\u0300-\u036f]/g, '')
      .replace(/Æ/g, 'Ae').replace(/æ/g, 'ae').trim().toLowerCase();
    const wanted = plain(value);
    if (!wanted || options.includes(value)) { return value; }
    return options.find((option) => plain(option) === wanted) ||
      options.find((option) => plain(option).startsWith(`${wanted} `)) ||
      value;
  };

  // Culture, Caste, Archetype and Specialization used to be free text; match
  // old and imported values to the dropdowns on sheet open.
  const ccNormalizeIdentity = (attributes) => {
    const match = (field, options) => {
      const value = ccMatchOption(attributes[field], options);
      if (value !== attributes[field]) { attributes[field] = value; }
    };
    match('culture', ccCultures);
    match('caste', ccCastes);
    match('archetype', Object.keys(ccSpecializations));
    match('specialization', Object.values(ccSpecializations).flat());
    // A known specialization with no archetype implies the archetype.
    if (!ccSpecializations[attributes.archetype]) {
      const owner = Object.keys(ccSpecializations)
        .find((archetype) => ccSpecializations[archetype].includes(attributes.specialization));
      if (owner && !attributes.archetype) { attributes.archetype = owner; }
    }
    attributes.archetype_marker = calcArchetypeMarker({attributes});
  };

+scss.
  .cc-character {
    .cc-footer {
      display: flex;
      justify-content: space-between;
      gap: 0.5rem;
      margin-top: 0.4rem;
      padding-top: 0.2rem;
      border-top: 1px solid var(--cc-rule);
      font-size: 0.65rem;
      color: var(--cc-ink);
      opacity: 0.6;
    }

    // This text is only in the CSS: if it's missing or older than .cc-build-
    // html, the Sheet Style paste is stale.
    .cc-build-css::after {
      content: "CSS build: #{buildVersion}";
    }

    .cc-languages textarea {
      min-height: 4rem;
    }

    // The tier labels show on NPC sheets only.
    .cc-character-type {
      display: none;
    }

    #cc-character-type-trooper:checked ~ .cc-character-type,
    #cc-character-type-toughened:checked ~ .cc-character-type,
    #cc-character-type-nemesis:checked ~ .cc-character-type {
      display: flex;
      margin-bottom: 0.4rem;
    }

    // Hidden but still real radios; the labels are what gets clicked.
    .cc-character-type-input {
      position: absolute;
      opacity: 0;
      width: 0;
      height: 0;
    }

    .cc-character-type-label {
      flex: 1 1 auto;
      text-align: center;
      background: var(--cc-editable-fill);
      color: var(--cc-ink);
      border: 1px solid var(--cc-rule);
      padding: 0.2rem 0.5rem;
      font-size: 0.7rem;
      text-transform: uppercase;
      letter-spacing: 0.03em;
      cursor: pointer;

      // Segmented control: shared borders, rounded outer ends.
      & + & {
        border-left: none;
      }

      &:first-of-type {
        border-radius: 4px 0 0 4px;
      }

      &:last-of-type {
        border-radius: 0 4px 4px 0;
      }
    }

    // The label is nested in .cc-character-type, so this needs the sibling-
    // then-descendant form.
    #cc-character-type-trooper:checked ~ .cc-character-type label[for='cc-character-type-trooper'],
    #cc-character-type-toughened:checked ~ .cc-character-type label[for='cc-character-type-toughened'],
    #cc-character-type-nemesis:checked ~ .cc-character-type label[for='cc-character-type-nemesis'] {
      background: var(--cc-banner);
      color: var(--cc-banner-text);
      border-color: var(--cc-banner);
    }

    // Trooper and Toughened: drop identity flavor, Languages and Experience
    // (reached through their shared .cc-field-group).
    #cc-character-type-trooper:checked ~ .cc-identity-extra,
    #cc-character-type-trooper:checked ~ .cc-identity-flavor,
    #cc-character-type-trooper:checked ~ .cc-field-group .cc-languages,
    #cc-character-type-trooper:checked ~ .cc-field-group .cc-experience,
    #cc-character-type-toughened:checked ~ .cc-identity-extra,
    #cc-character-type-toughened:checked ~ .cc-identity-flavor,
    #cc-character-type-toughened:checked ~ .cc-field-group .cc-languages,
    #cc-character-type-toughened:checked ~ .cc-field-group .cc-experience {
      display: none;
    }

    // Every NPC tier: Truths but no Scars, and no Fortune track (NPC Fortune
    // costs 3 Threat).
    #cc-character-type-trooper:checked ~ .cc-truths-scars .cc-scar,
    #cc-character-type-trooper:checked ~ .cc-truths-scars .cc-truths-scars-toggle,
    #cc-character-type-trooper:checked ~ .cc-truths-scars .cc-truths-scars-extra,
    #cc-character-type-trooper:checked ~ .cc-vitals .cc-vitals-fortune,
    #cc-character-type-toughened:checked ~ .cc-truths-scars .cc-scar,
    #cc-character-type-toughened:checked ~ .cc-truths-scars .cc-truths-scars-toggle,
    #cc-character-type-toughened:checked ~ .cc-truths-scars .cc-truths-scars-extra,
    #cc-character-type-toughened:checked ~ .cc-vitals .cc-vitals-fortune,
    #cc-character-type-nemesis:checked ~ .cc-truths-scars .cc-scar,
    #cc-character-type-nemesis:checked ~ .cc-truths-scars .cc-truths-scars-toggle,
    #cc-character-type-nemesis:checked ~ .cc-truths-scars .cc-truths-scars-extra,
    #cc-character-type-nemesis:checked ~ .cc-vitals .cc-vitals-fortune {
      display: none;
    }

    // Show only the Specialization select for the checked archetype.
    .cc-archetype-marker,
    .cc-specialization {
      display: none;
    }

    .cc-archetype-marker-none:checked ~ .cc-field .cc-specialization-none,
    .cc-archetype-marker-mystic:checked ~ .cc-field .cc-specialization-mystic,
    .cc-archetype-marker-sage:checked ~ .cc-field .cc-specialization-sage,
    .cc-archetype-marker-schemer:checked ~ .cc-field .cc-specialization-schemer,
    .cc-archetype-marker-scoundrel:checked ~ .cc-field .cc-specialization-scoundrel,
    .cc-archetype-marker-scout:checked ~ .cc-field .cc-specialization-scout,
    .cc-archetype-marker-soldier:checked ~ .cc-field .cc-specialization-soldier {
      display: block;
    }

    // NPC-only panels are hidden for players.
    .cc-npc-panel {
      display: none;
    }

    #cc-character-type-trooper:checked ~ .cc-npc-panel,
    #cc-character-type-toughened:checked ~ .cc-npc-panel,
    #cc-character-type-nemesis:checked ~ .cc-npc-panel {
      display: block;
    }

    // One tier note per tier in the NPC Profile panel.
    .cc-tier-note {
      display: none;
    }

    #cc-character-type-trooper:checked ~ .cc-npc-profile .cc-tier-note-trooper,
    #cc-character-type-toughened:checked ~ .cc-npc-profile .cc-tier-note-toughened,
    #cc-character-type-nemesis:checked ~ .cc-npc-profile .cc-tier-note-nemesis {
      display: block;
    }
  }
