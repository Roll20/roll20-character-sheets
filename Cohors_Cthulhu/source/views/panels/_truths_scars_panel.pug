//- views/panels/_truths_scars_panel.pug
//- Personal Truths & Scars panel. Markup and CSS only.
.cc-panel.cc-truths-scars
  .cc-banner Personal Truths &amp; Scars
  //- A 3-column grid: 5 truths + 5 scars make 4 rows. Rows 1-2 always show;
  //- rows 3-4 (scars 2-5) sit behind the expand toggle (a :checked sibling
  //- selector).
  .cc-truths-scars-grid
    each n in [1, 2, 3, 4, 5]
      +text({name: `truth ${n}`}).cc-truth
    +text({name: 'scar 1'}).cc-scar
  +checkbox({name: 'truths scars expanded', id: 'cc-truths-scars-expand'}).cc-truths-scars-checkbox
  label.cc-truths-scars-toggle(for='cc-truths-scars-expand')
    span.cc-truths-scars-arrow
    span Scars 2-5
  .cc-truths-scars-grid.cc-truths-scars-extra
    each n in [2, 3, 4, 5]
      +text({name: `scar ${n}`}).cc-scar

+scss.
  .cc-character {
    .cc-truths-scars-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 0.3rem;

      .cc-truth,
      .cc-scar {
        width: 100%;
        // Same light fill as .cc-field's editable inputs.
        background: var(--cc-editable-fill);
        border: none;
        border-bottom: 1px solid var(--cc-rule);
        color: var(--cc-ink);
        padding: 0.15rem 0.1rem;
      }
    }

    // Visually hidden but still checkable.
    .cc-truths-scars-checkbox {
      position: absolute;
      opacity: 0;
      width: 0;
      height: 0;
    }

    .cc-truths-scars-extra {
      display: none;
    }

    .cc-truths-scars-checkbox:checked ~ .cc-truths-scars-extra {
      display: grid;
    }

    .cc-truths-scars-toggle {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.3rem;
      margin-top: 0.3rem;
      font-size: 0.7rem;
      text-transform: uppercase;
      letter-spacing: 0.03em;
      color: var(--cc-rule);
      cursor: pointer;

      .cc-truths-scars-arrow {
        display: inline-block;
        transition: transform 150ms ease-out;

        &:before {
          content: '\25BE'; // ▾ (BMP, not an emoji)
        }
      }
    }

    .cc-truths-scars-checkbox:checked ~ .cc-truths-scars-toggle .cc-truths-scars-arrow {
      transform: rotate(180deg);
    }
  }
