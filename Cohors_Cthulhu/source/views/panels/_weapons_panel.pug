+scss.
  .cc-character {
    .cc-rep-weapons {
      .cc-rep-header,
      fieldset,
      .repcontainer .repitem {
        grid-template-columns: 1.6rem 1.3fr 1fr 0.9fr 1.7fr 0.6fr 1.2fr;
        align-items: center;
      }

      // Player characters: dropdown, no apply button, no Type column.
      .cc-npc-col,
      .cc-weapon-name-text {
        display: none;
      }

      // Same icon button as .cc-talent-apply.
      .cc-weapon-apply {
        background: none;
        border: none;
        padding: 0;
        color: inherit;
        font-size: 1rem;
        cursor: pointer;
        justify-self: center;

        &:before {
          content: '\21BB';
          opacity: 0.8;
        }

        &:hover:before {
          opacity: 1;
        }
      }

      // Same stone block as .cc-focus-roll, as a small square chip with the
      // square fleck pattern.
      .cc-weapon-roll {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 1.4rem;
        height: 1.4rem;
        background-image:
          radial-gradient(circle at 61% 17%, rgba(74, 53, 30, 0.6) 0%, transparent 6%),
          radial-gradient(circle at 27% 68%, rgba(92, 74, 48, 0.5) 0%, transparent 4%),
          radial-gradient(circle at 83% 19%, rgba(92, 74, 48, 0.5) 0%, transparent 3%),
          radial-gradient(circle at 11% 29%, rgba(92, 74, 48, 0.5) 0%, transparent 3%),
          radial-gradient(circle at 7% 25%, rgba(109, 80, 52, 0.55) 0%, transparent 2%),
          radial-gradient(circle at 54% 27%, rgba(109, 80, 52, 0.55) 0%, transparent 2%),
          radial-gradient(circle at 78% 9%, rgba(109, 80, 52, 0.55) 0%, transparent 2%),
          radial-gradient(circle at 68% 37%, rgba(109, 80, 52, 0.55) 0%, transparent 1%),
          linear-gradient(145deg, var(--cc-stone-light) 0%, var(--cc-stone-dark) 100%);
        background-repeat: no-repeat;
        background-size: 100% 100%;
        border: 1px solid var(--cc-stone-bezel);
        border-radius: 4px;
        box-shadow:
          inset 0 1px 0 rgba(255, 255, 255, 0.45),
          0 1px 1px rgba(0, 0, 0, 0.2);
        color: var(--cc-ink);
        font-size: 1.1rem;
        cursor: pointer;
        justify-self: center;

        &:before {
          content: '0';
          opacity: 1;
        }

        // Flat maroon fill instead of the stone texture.
        &:hover {
          background-image: none;
          background-color: var(--cc-banner);
          border-color: var(--cc-banner);
          color: var(--cc-banner-text);
        }
      }
    }
  }

