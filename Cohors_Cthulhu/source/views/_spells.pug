//- views/_spells.pug
//- Spells tab: spellcasting header and a repeating spell list.
- const ccSpellbooks = require('./source/data/spells.json');
+tab({name: 'spells', container: 'article', button: {content: 'Spells'}})
  .cc-page.cc-spells

    //- Hidden PC/NPC marker for this page's CSS, calculated from
    //- character_type (calcSpellsTypeMarker). It can't be more character_type
    //- radios: radios with the same name form one group across the sheet.
    +radio({name: 'spells type marker', value: 'pc', checked: '', trigger: {calculation: 'calcSpellsTypeMarker'}}).cc-spells-type.cc-spells-type-pc
    +radio({name: 'spells type marker', value: 'npc', trigger: {calculation: 'calcSpellsTypeMarker'}}).cc-spells-type.cc-spells-type-npc

    .cc-panel.cc-spellcasting-header
      .cc-banner Spellcasting
      .cc-field-group
        //- Player and NPC versions of the same attribute; CSS shows one,
        //- driven by spells_type_marker. The NPC versions add "Spellcaster
        //- (Attribute) X" and the Mythos tomes.
        .cc-field
          span Spellcasting Type
          +select({
            name: 'spellcasting type',
            trigger: {affects: ['spellcasting_attribute', 'base_power', 'power_rating']}
          }).cc-pc-only
            +option({value: ''})
              | Select One
            +option({value: 'traditional'})
              | Traditional
            +option({value: 'research'})
              | Research
            +option({value: 'dabbling'})
              | Dabbling
          +select({
            name: 'spellcasting type',
            trigger: {affects: ['spellcasting_attribute', 'base_power', 'power_rating']}
          }).cc-npc-only
            +option({value: ''})
              | Select One
            +option({value: 'traditional'})
              | Traditional
            +option({value: 'research'})
              | Research
            +option({value: 'dabbling'})
              | Dabbling
            +option({value: 'npc_insight'})
              | NPC Spellcaster (Insight)
            +option({value: 'npc_reason'})
              | NPC Spellcaster (Reason)
            +option({value: 'npc_will'})
              | NPC Spellcaster (Will)
        .cc-field
          span Magical Tradition
          //- A fixed choice: the Spell Name dropdown is filtered by it.
          +select({
            name: 'magical tradition',
            trigger: {affects: ['tradition_marker']}
          }).cc-pc-only
            +option({value: ''})
              | Select One
            +option({value: 'runic'})
              | Runic
            +option({value: 'oracular'})
              | Oracular
            +option({value: 'celtic'})
              | Celtic
          +select({
            name: 'magical tradition',
            trigger: {affects: ['tradition_marker']}
          }).cc-npc-only
            +option({value: ''})
              | Select One
            +option({value: 'runic'})
              | Runic
            +option({value: 'oracular'})
              | Oracular
            +option({value: 'celtic'})
              | Celtic
            +option({value: 'cthulhu'})
              | Tome of Cthulhu
            +option({value: 'mormo'})
              | Compendium of Mormo
            +option({value: 'nyarlathotep'})
              | Grimoire of Nyarlathotep
            +option({value: 'yog_sothoth'})
              | Spellbook of Yog-Sothoth
        .cc-field
          //- Derived from Spellcasting Type: Traditional uses Insight,
          //- Research Reason, Dabbling Will.
          span Spellcasting Attribute
          +text({
            name: 'spellcasting attribute',
            readonly: true,
            trigger: {calculation: 'calcSpellcastingAttribute', affects: ['power_rating']}
          })
        .cc-field
          span Power Rating
          +number({name: 'power rating', readonly: true, trigger: {calculation: 'calcPowerRating'}})
        .cc-field
          span Base Power
          +number({name: 'base power', readonly: true, trigger: {calculation: 'calcBasePower', affects: ['power_rating']}})

    //- Hidden radios mirroring Magical Tradition, so CSS can match on
    //- :checked. They must be direct siblings of .cc-spell-list for the ~
    //- selector.
    +radio({
      name: 'tradition marker',
      value: 'runic',
      trigger: {calculation: 'calcTraditionMarker'}
    }).cc-tradition-marker-runic
    +radio({
      name: 'tradition marker',
      value: 'oracular',
      trigger: {calculation: 'calcTraditionMarker'}
    }).cc-tradition-marker-oracular
    +radio({
      name: 'tradition marker',
      value: 'celtic',
      trigger: {calculation: 'calcTraditionMarker'}
    }).cc-tradition-marker-celtic
    +radio({
      name: 'tradition marker',
      value: 'cthulhu',
      trigger: {calculation: 'calcTraditionMarker'}
    }).cc-tradition-marker-cthulhu
    +radio({
      name: 'tradition marker',
      value: 'mormo',
      trigger: {calculation: 'calcTraditionMarker'}
    }).cc-tradition-marker-mormo
    +radio({
      name: 'tradition marker',
      value: 'nyarlathotep',
      trigger: {calculation: 'calcTraditionMarker'}
    }).cc-tradition-marker-nyarlathotep
    +radio({
      name: 'tradition marker',
      value: 'yog_sothoth',
      trigger: {calculation: 'calcTraditionMarker'}
    }).cc-tradition-marker-yog_sothoth

    .cc-panel.cc-spell-list
      .cc-banner Spells
      +fieldset({name: 'spell'})
        .cc-spell-block
          .cc-field-group
            //- Hidden: set when the spell is an attack spell (see
