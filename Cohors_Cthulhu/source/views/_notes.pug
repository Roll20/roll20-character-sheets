//- views/_notes.pug
//- Notes tab: Traits, History, Personal Agenda, Journal/Notes and Belongings.
+tab({name: 'notes', container: 'article', button: {content: 'Notes'}})
  .cc-page.cc-notes

    .cc-field-group
      .cc-panel.cc-traits
        .cc-banner Traits
        +textarea({name: 'traits'})
      .cc-panel.cc-history-agenda
        .cc-banner History
        +textarea({name: 'history'})
        .cc-banner Personal Agenda
        +textarea({name: 'personal agenda'})

    .cc-panel.cc-belongings
      .cc-banner Belongings
      +textarea({name: 'belongings'})

    .cc-panel.cc-journal
      .cc-banner Journal/Notes
      +textarea({name: 'journal notes'})

+scss.
  .cc-notes {
    .cc-field-group {
      align-items: stretch;
    }

    .cc-traits,
    .cc-history-agenda {
      flex: 1 1 45%;
    }

    textarea {
      width: 100%;
      min-height: 6rem;
      // Soft-bordered boxes with the editable-field fill for every textarea
      // on this page.
      background: var(--cc-editable-fill);
      border: 1px solid var(--cc-rule-soft);
      color: var(--cc-ink);
    }

    .cc-journal textarea {
      min-height: 14rem;
    }
  }
