//- Cohors_Cthulhu.pug
include k-scaffold
include ./components/_index.pug

- k.sheetName = "CohorsCthulhu";
- k.version = "0.1.0";

+hidden({name: 'sheet version', value: '0.1.0'})

main#main
  //- Player/NPC switch, level with the tab buttons on every tab. The
  //- transparent checkbox covers the whole switch; the spans after it show
  //- its state. npc_sheet is kept in step with character_type
  //- (ccSetSheetMode, calcNpcSheet in views/_character.pug), and the NPC
  //- import sets both.
  .cc-sheet-mode
    +checkbox({name: 'npc sheet', value: 1, trigger: {initialFunc: 'ccSetSheetMode', calculation: 'calcNpcSheet'}}).cc-sheet-mode-input(title='Switch between a player character and an NPC sheet')
    span.cc-sheet-mode-option.cc-sheet-mode-player Player
    span.cc-sheet-mode-track
    span.cc-sheet-mode-option.cc-sheet-mode-npc NPC
  +tabs({name: 'cohors-cthulhu', defaultActiveTab: 'character'})
    include ./views/_index.pug

include ./rolltemplate/_index.pug

+kscript
    | k.sheetName = "CohorsCthulhu";
    | k.version = "0.1.0";
