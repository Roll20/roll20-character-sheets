//- rolltemplate/_index.pug
//- Chat card for 2d20 rolls: dice, target number, successes, complications
//- and pass/fail with Momentum generated. Weapon rolls and attack spells (has_damage) add a
//- Damage section and spell rolls (is_spell) a Cost section, rolled in the
//- same message.
+rolltemplate('ccskill')
  //- The card's styling is on this inner wrapper.
  .cc-roll-card
    +characterLink
    .cc-roll-header
      span.cc-roll-skill {{skill}}
      +templateConditionalDisplay('focus')
        span.cc-roll-focus ({{focus}})
    .cc-roll-body
      //- Fields set by finishRoll must be referenced as computed::field, and
      //- conditionals on them use rollGreater()/rollTotal(); {{#field}} only
      //- tests that a field exists. difficulty and has_damage are never
      //- overridden, so they stay plain.
      .cc-roll-row
        span Dice:
        span {{computed::dice_text}}
      //- Pool spent by the roll: bought d20s, extra damage dice, and a
      //- spell's Extra Momentum. Shown only when something was spent.
      +rollGreater({values: 'computed::momentum_spent 0'})
        .cc-roll-row
          span {{pool}} Spent:
          span {{computed::momentum_spent}}
      .cc-roll-row
        span Target Number:
        span {{computed::target_number}}
      .cc-roll-row
        span Difficulty:
        span {{difficulty}}
      .cc-roll-row
        span Successes:
        span {{computed::successes}}
      //- Extraordinary [Attribute] X; already counted in Successes.
      +rollGreater({values: 'computed::auto_successes 0'})
        .cc-roll-row
          span Extraordinary (auto):
          span +{{computed::auto_successes}}
      +rollGreater({values: 'computed::complications 0'})
        .cc-roll-row.cc-roll-complication
          span Complications:
          span {{computed::complications}}
    +rollTotal({values: 'computed::outcome 1'})
      .cc-roll-outcome.cc-roll-pass
        span Passed - {{pool}}: {{computed::bonus_momentum}}
    +rollTotal({values: 'computed::outcome 0'})
      .cc-roll-outcome.cc-roll-fail
        span Failed
    //- Fatigue resist rolls only.
    +rollGreater({values: 'computed::fatigue_removed 0'})
      .cc-roll-row
        span Fatigue Removed:
        span {{computed::fatigue_removed}}
    //- Damage is always rolled with the attack; it is only shown on a pass
    //- (computed::outcome 1).
    //- {{pool}} is a plain literal (Threat for an adversary, else Momentum),
    //- so it needs no computed::.
    +templateConditionalDisplay('mental')
      .cc-roll-row.cc-roll-note
        span Target must be aware of the attacker and within Medium range. Resisted by Courage + Morale.
    +templateConditionalDisplay('has_damage')
      +rollTotal({values: 'computed::outcome 1'})
        .cc-roll-header.cc-roll-damage-header
          span.cc-roll-skill Damage
        .cc-roll-body
          .cc-roll-row
            span Challenge Dice:
            span.cc-roll-dice-result {{computed::damage_dice_text}}
          //- An attack spell's Power; already in the dice above.
          +rollGreater({values: 'computed::spell_power_damage 0'})
            .cc-roll-row
              span Power:
              span +{{computed::spell_power_damage}}
          //- Extra damage dice bought on the hit; already in the dice above.
          +rollGreater({values: 'computed::extra_damage 0'})
            .cc-roll-row
              span Extra Damage Dice:
              span +{{computed::extra_damage}}
          .cc-roll-row
            span Total Damage:
            span {{computed::total_damage}}
          //- Only shown when an Effect came up.
          +rollGreater({values: 'computed::effect_count 0'})
            .cc-roll-row.cc-roll-complication
              span {{computed::effects_summary}}
    //- The Cost is paid whether the cast succeeds or not, so it is always
    //- shown.
    +templateConditionalDisplay('is_spell')
      //- A Dabbler casting at Power 3: 1 Threat per Effect on the Cost and
      //- Damage dice.
      +rollGreater({values: 'computed::dabbling_power_threat 0'})
        .cc-roll-row.cc-roll-complication
          span {{computed::dabbling_power_threat}} threat generated by casting at Power 3 (1 per Effect on the Cost and Damage dice)
      .cc-roll-header.cc-roll-damage-header
        span.cc-roll-skill Cost (paid regardless of outcome)
      .cc-roll-body
        .cc-roll-row
          span Challenge Dice:
          span.cc-roll-dice-result {{computed::cost_dice_text}}
        .cc-roll-row
          span Mental Damage to Caster:
          span {{computed::cost_total}}
        //- Only shown when an Effect came up.
        +rollGreater({values: 'computed::cost_effect_count 0'})
          .cc-roll-row.cc-roll-complication
            span {{computed::cost_effects_summary}}
        //- Spells in ccSpellCostThreatPerEffect (Curse of Loki) only.
        +rollGreater({values: 'computed::cost_threat_generated 0'})
          .cc-roll-row.cc-roll-complication
            span {{computed::cost_threat_generated}} threat generated from this spell's cost effects

//- Hidden signal carrying a Momentum delta to the API script's Momentum pool
//- (CohorsCthulhuCompanion.js; see ccSendMomentumSignal). The script
//- matches on the template name (msg.rolltemplate), so renaming a signal
//- template means updating the script too.
+rolltemplate('ccmomentumsignal')
  span.cc-momentum-signal-delta {{ccmomentumdelta}}

//- Hidden signal for the API script's Threat pool.
+rolltemplate('ccthreatsignal')
  span.cc-threat-signal-delta {{ccthreatdelta}}

//- Hidden signal for a spend the pool may not cover
//- (ccSendMomentumSpendSignal). The API script spends what the pool has and
//- converts the shortfall into a ccthreatsignal.
+rolltemplate('ccmomentumspendsignal')
  span.cc-momentum-spend-signal-amount {{ccmomentumspend}}

+scss('roll').
  /* Classes inside a rolltemplate need the "sheet-" prefix here, except the
     sheet-rolltemplate-<name> class and Roll20's .inlinerollresult. Colors
     are plain values: the sheet's custom properties don't reach chat, though
     var() declared on the template root works. */
  .sheet-rolltemplate-ccskill .sheet-cc-roll-card {
    font-family: Georgia, serif;
    background: #ece3cd;
    color: #2b2018;
    border: 1px solid #8a1c2b;
    border-radius: 3px;
    padding: 0.4rem 0.6rem;
    min-width: 220px;

    .sheet-character_name {
      margin: 0 0 0.2rem;
      font-size: 1rem;
    }

    /* Strip Roll20's yellow highlight from computed:: inline-roll spans so
       they read as plain text. */
    .inlinerollresult {
      background-color: transparent !important;
      border: 0 transparent !important;
      font-weight: inherit;
      font-size: inherit;
      padding: 0 !important;
      pointer-events: none;
    }

    .sheet-cc-roll-header {
      font-weight: bold;
      text-transform: uppercase;
      letter-spacing: 0.03em;
      color: #8a1c2b;
      margin-bottom: 0.2rem;

      .sheet-cc-roll-focus {
        font-style: italic;
        text-transform: none;
        font-weight: normal;
        margin-left: 0.3rem;
      }
    }

    .sheet-cc-roll-damage-header {
      margin-top: 0.3rem;
      padding-top: 0.3rem;
      border-top: 1px dashed #8a1c2b;
    }

    .sheet-cc-roll-row {
      display: flex;
      justify-content: space-between;
      gap: 0.5rem;
      font-size: 0.9rem;
    }

    /* Challenge Dice symbols read larger than the row text. */
    .sheet-cc-roll-dice-result {
      font-size: 1.4rem;
    }

    .sheet-cc-roll-note {
      font-size: 0.8rem;
      font-style: italic;
    }

    .sheet-cc-roll-complication {
      color: #8a1c2b;
      font-weight: bold;
    }

    .sheet-cc-roll-outcome {
      margin-top: 0.3rem;
      font-weight: bold;
      text-align: center;
      padding: 0.15rem;
      border-radius: 2px;
    }

    .sheet-cc-roll-pass {
      background: #2f4a2f;
      color: #e8f0e8;
    }

    .sheet-cc-roll-fail {
      background: #4a1414;
      color: #f0e0e0;
    }
  }

  /* Signal cards are never shown; the API scripts read the message, not the
     display. */
  .sheet-rolltemplate-ccmomentumsignal,
  .sheet-rolltemplate-ccthreatsignal,
  .sheet-rolltemplate-ccmomentumspendsignal {
    display: none;
  }
